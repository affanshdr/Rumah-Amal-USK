// This is your Prisma schema file for Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Zakat {
  id                String   @id @default(cuid())
  tipePembayar      String   @default("masyarakat") @map("tipe_pembayar")
  jenisZakat        String   @map("jenis_zakat")
  sumberDana        String?  @map("sumber_dana")
  jenisPerusahaan   String?  @map("jenis_perusahaan")
  jumlahZakat       Float    @map("jumlah_zakat")
  nama              String
  nip               String?
  email             String?
  alamat            String?
  noHp              String?  @map("no_hp")
  isHambaAllah      Boolean  @default(false) @map("is_hamba_allah")
  bersediaDihubungi Boolean  @default(false) @map("bersedia_dihubungi")
  pesan             String?
  buktiPembayaran   String?  @map("bukti_pembayaran")
  setujuTerms       Boolean  @default(false) @map("setuju_terms")
  status            String   @default("pending")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("zakats")
}

model Infaq {
  id                String   @id @default(cuid())
  tipePembayar      String   @default("masyarakat") @map("tipe_pembayar")
  jenisInfaq        String   @map("jenis_infaq")
  jumlahInfaq       Float    @map("jumlah_infaq")
  nama              String
  nip               String?
  email             String?
  alamat            String?
  noHp              String?  @map("no_hp")
  isHambaAllah      Boolean  @default(false) @map("is_hamba_allah")
  bersediaDihubungi Boolean  @default(false) @map("bersedia_dihubungi")
  pesan             String?
  buktiPembayaran   String?  @map("bukti_pembayaran")
  setujuTerms       Boolean  @default(false) @map("setuju_terms")
  status            String   @default("pending")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("infaqs")
}

model Gallery {
  id        String   @id @default(cuid())
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("galleries")
}

model Newsletter {
  id        String   @id @default(cuid())
  judul     String
  imageUrl  String   @map("image_url")
  tanggal   DateTime @map("tanggal")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletters")
}

model Donasi {
  id                String    @id @default(cuid())
  tipePembayar      String    @default("masyarakat") @map("tipe_pembayar")
  jenisDonasi       String    @map("jenis_donasi")
  kampanyeId        String?   @map("kampanye_id")
  kampanye          Kampanye? @relation(fields: [kampanyeId], references: [id], onDelete: SetNull)
  jumlahDonasi      Float     @map("jumlah_donasi")
  nama              String
  nip               String?
  email             String?
  alamat            String?
  noHp              String?   @map("no_hp")
  isHambaAllah      Boolean   @default(false) @map("is_hamba_allah")
  bersediaDihubungi Boolean   @default(false) @map("bersedia_dihubungi")
  pesan             String?
  buktiPembayaran   String?   @map("bukti_pembayaran")
  setujuTerms       Boolean   @default(false) @map("setuju_terms")
  status            String    @default("pending")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("donasies")
}

model Kampanye {
  id             String    @id @default(cuid())
  judul          String
  deskripsi      String?
  imageUrl       String    @map("image_url")
  targetDana     Float?    @map("target_dana")
  terkumpul      Float     @default(0)
  tanggalSelesai DateTime? @map("tanggal_selesai")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  donasi         Donasi[]

  @@map("kampanyes")
}

model Tag {
  id            String         @id @default(cuid())
  name          String         @unique
  announcements Announcement[]

  @@map("tags")
}

model Announcement {
  id            String                @id @default(cuid())
  title         String
  slug          String                @unique
  excerpt       String?
  category      String?               @default("Umum")
  coverImageUrl String?               @map("cover_image_url")
  content       String                @db.Text
  viewsCount    Int                   @default(0) @map("views_count")
  published     Boolean               @default(true)
  publishedAt   DateTime?             @default(now()) @map("published_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  tags          Tag[]
  comments      AnnouncementComment[]

  @@map("announcements")
}

model AnnouncementComment {
  id             String               @id @default(cuid())
  announcementId String               @map("announcement_id")
  announcement   Announcement         @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  name           String?              // Nama komentator (opsional / default: Anonim)
  content        String               @db.Text
  isApproved     Boolean              @default(true) @map("is_approved")
  parentId       String?              @map("parent_id")
  parent         AnnouncementComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        AnnouncementComment[] @relation("CommentReplies")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@map("announcement_comments")
}

model Mitra {
  id        String   @id @default(cuid())
  nama      String
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("mitras")
}

model Document {
  id            String   @id @default(cuid())
  judul         String
  imageUrl      String?  @map("image_url")
  pdfUrl        String   @map("pdf_url")
  fileSize      Float?   @map("file_size")       // Ukuran file dalam MB (null jika pakai link Drive)
  downloadCount Int      @default(0) @map("download_count") // Jumlah klik tombol download
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("documents")
}

model Program {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  category      String    @default("PENDIDIKAN")
  excerpt       String?
  coverImageUrl String?   @map("cover_image_url")
  content       String    @db.Text
  viewsCount    Int       @default(0) @map("views_count")
  published     Boolean   @default(true)
  publishedAt   DateTime? @default(now()) @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("programs")
}
